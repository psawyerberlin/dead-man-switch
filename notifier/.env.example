# Messenger configuration. Copy to a file OUTSIDE the repository (see compose.yaml) and fill in.
# 32 random bytes as 64 hex characters (e.g. `openssl rand -hex 32`); encrypts personal data at rest. Losing it loses the data.
NOTIFIER_DATA_KEY=
# SMTP server of the mailbox that sends the emails.
SMTP_HOST=smtp.strato.de
# 465 = implicit TLS, 587 = STARTTLS (required).
SMTP_PORT=465
# Mailbox login (the sender address must be this mailbox).
SMTP_USER=
# Mailbox password; kept in the real env file only.
SMTP_PASS=
# Sender, `Name <address>`; the address must equal SMTP_USER or the service refuses to start.
MAIL_FROM=dead-man-switch <dead-man-switch_noreply@example.org>
# Public origin of the web app (used in the links of the emails).
APP_URL=https://example.org
# CKB RPC endpoints, one per enabled network.
RPC_TESTNET=https://testnet.ckb.dev/rpc
RPC_MAINNET=https://mainnet.ckb.dev/rpc
# Comma-separated networks the watcher serves (testnet now).
NETWORKS=testnet
# Optional: listen port (default 8787), data directory (default /data).
PORT=8787
DATA_DIR=/data
# Optional: 1 when behind the reverse proxy, to trust X-Forwarded-For for rate limits.
TRUST_PROXY=1
