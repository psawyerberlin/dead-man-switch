{
  "name": "dead-man-switch-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "dead-man-switch web application and single-file opener",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && OPENER=1 vite build && node scripts/copy-to-site.mjs",
    "build:opener": "OPENER=1 vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0",
    "@crt/client": "file:../.refs/crt/client",
    "@noble/hashes": "^1.8.0",
    "fflate": "^0.8.2",
    "marked": "^15.0.0",
    "dompurify": "^3.2.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
